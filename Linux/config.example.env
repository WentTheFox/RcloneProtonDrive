# Sourced by rclone-protondrive-sync (shell syntax, no spaces around =).

# Folder being synced, and the rclone remote it syncs with.
LOCAL_PATH=/mnt/d/ProtonDrive
REMOTE=ProtonDrive:

# bisync   = two-way sync.
# download = one-way remote -> LOCAL_PATH, never deletes locally (safe starting point).
MODE=bisync

# Sync is skipped unless this is a mount point (so a missing drive can't fill the root
# disk). Empty disables the check.
REQUIRE_MOUNT=/mnt/d

# rclone rc / web UI bind address (only up while a sync is running).
RC_ADDR=localhost:5573
