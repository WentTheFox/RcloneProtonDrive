[Unit]
Description=One-way initial download of Proton Drive (rclone copy)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
TimeoutStartSec=infinity
EnvironmentFile=-%h/.config/rclone-protondrive/rc.env
# Disables itself once a full pass finishes without errors, so it resumes after reboots until done
ExecStart=/bin/bash -c '%h/.local/bin/rclone-protondrive-sync download \
  && systemctl --user disable rclone-protondrive-download.service'

[Install]
WantedBy=default.target
